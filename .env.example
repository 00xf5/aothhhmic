# Base URL: Publicly accessible URL where this application is hosted.
# Used for OAuth callbacks, redirect validation, and self-referential links.
APP_URL="http://localhost:3000"

# Microsoft Entra ID (Azure AD) OAuth 2.0 Credentials
# Registered via the Azure Portal (https://portal.azure.com) -> Microsoft Entra ID -> App registrations
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Tenant ID:
# - "common": Multi-tenant organizations and personal Microsoft accounts (MSA)
# - "organizations": Any Microsoft work or school account
# - "consumers": Personal Microsoft accounts only
# - "<tenant-uuid>": Single-tenant organization directory ID
AZURE_TENANT_ID="common"
